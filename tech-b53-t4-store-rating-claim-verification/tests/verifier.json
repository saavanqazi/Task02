    {
      "name": "register_exists",
      "metadata": {
        "how_justification": "Checks claim_register.csv is present as a file in the workspace.",
        "why_justification": "The per-claim register reached the workspace.",
        "tag": "core"
      },
      "source": {
        "type": "file",
        "file": {
          "type": "filesystem",
          "command": "check_path_exists",
          "arguments": {
            "path": "claim_register.csv"
          }
        }
      },
      "assertion": {
        "type": "deterministic",
        "expected": true,
        "deterministic": {
          "path": "$.is_file",
          "comparison": "equals"
        }
      }
    },
    {
      "name": "register_header",
      "metadata": {
        "how_justification": "Opens claim_register.csv with csv.extract_text and applies regex_match.",
        "why_justification": "The contract document pins this header line character for character, so a renamed or resequenced field breaks the layout the corrections desk is sent. Entailed by: \"Header, exactly: `claim_id,true_average,true_count,driver`\"",
        "tag": "core"
      },
      "source": {
        "type": "file",
        "file": {
          "type": "csv",
          "command": "extract_text",
          "arguments": {
            "path": "claim_register.csv"
          }
        }
      },
      "assertion": {
        "type": "deterministic",
        "expected": "(?i)\\A\\x22?claim_id\\x22?[ \\t]*,[ \\t]*\\x22?true_average\\x22?[ \\t]*,[ \\t]*\\x22?true_count\\x22?[ \\t]*,[ \\t]*\\x22?driver\\x22?[ \\t]*\\r?\\n",
        "deterministic": {
          "path": "$.text",
          "comparison": "regex_match"
        }
      }
    },
    {
      "name": "register_table_trap_rc07",
      "metadata": {
        "how_justification": "Parses claim_register.csv with csv.read_rows and applies table_equals to every graded cell of the RC-07 row (matched by 'claim_id'); the row is graded here and NOWHERE else, the bulk check below carrying only its id in the population lock; a failure names the exact cell.",
        "why_justification": "Every claim is verified on three axes at once: the store's real average, the store's real count, and which of the two — if either — the article got wrong. The article's own order governs the line-up as well, so a claim dropped from the register, one duplicated inside it, one resequenced against the article, and a listing the article never quotes smuggled in beside them each fail here. The two figures are graded beside the driver, cell by cell, because a driver stripped of the figure behind it is not something a corrections desk can act on. Entailed by: \"One row per claim in `input/claims.csv`, in that file's order — every claim earns a row, the ones the store bears out among them. `true_average` is the store's real average for that listing under `input/verification_rules.md`, written to one decimal place (`4.0`, not `4`). `true_count` is the store's real number of ratings for it, a plain whole number with no separator. `driver` is one of the four codes above, spelled exactly as it is spelled there.\"",
        "tag": "core"
      },
      "source": {
        "type": "file",
        "file": {
          "type": "csv",
          "command": "read_rows",
          "arguments": {
            "path": "claim_register.csv"
          }
        }
      },
      "assertion": {
        "type": "deterministic",
        "expected": {
          "id_column": "claim_id",
          "rows": {
            "RC-07": {
              "true_average": "4.4",
              "true_count": "533",
              "driver": "COUNT_WRONG"
            }
          },
          "cell_types": {
            "true_average": "number",
            "true_count": "number",
            "driver": "text"
          }
        },
        "deterministic": {
          "path": "$",
          "comparison": "table_equals"
        }
      }
    },
